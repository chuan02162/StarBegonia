# development | production（production 会拒绝弱密钥与 CORS=*）
STARBEGONIA_ENV=development

SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_FERNET_KEY=

# free compose 需要；开发 compose 可用默认 starbegonia/starbegonia
POSTGRES_PASSWORD=starbegonia

# 生产设为公网 Origin，例如 http://1cchome1.duckdns.org:5173
CORS_ORIGINS=*
APP_PUBLIC_URL=http://1cchome1.duckdns.org:5173

DEFAULT_CURRENCY=AUD
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_CONCURRENCY=8
JEV_CONFIDENCE_THRESHOLD=0.7
SOURCE_SYNC_CONCURRENCY=4

# OpenFeed (replaces BankSync). See docs/openfeed-setup.md
OPENFEED_ISSUER=https://auth.openfeed.au
OPENFEED_CLIENT_ID=
OPENFEED_APP_ID=
OPENFEED_APP_KID=
OPENFEED_DPOP_KID=
# PEM with literal \n escapes, or multiline in compose
OPENFEED_APP_PRIVATE_KEY=
OPENFEED_DPOP_PRIVATE_KEY=

# Nightly sync (worker). Sydney 00:00 sequential pull.
DAILY_SYNC_ENABLED=1
DAILY_SYNC_TZ=Australia/Sydney
DAILY_SYNC_HOUR=0
DAILY_SYNC_MINUTE=0
DAILY_SYNC_GAP_SECONDS=45
