# development | production（production 会拒绝弱密钥与 CORS=*）
STARBEGONIA_ENV=development

SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_FERNET_KEY=

# free compose 需要；开发 compose 可用默认 starbegonia/starbegonia
POSTGRES_PASSWORD=starbegonia

# 生产设为公网 Origin，例如 http://34.x.x.x 或 https://family.example.com
CORS_ORIGINS=*

DEFAULT_CURRENCY=AUD
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.7

# BankSync (CommBank CDR) — Workspace › Developers › API key with banks:read
BANKSYNC_API_KEY=

# Nightly sync (worker). Sydney 00:00 sequential pull.
DAILY_SYNC_ENABLED=1
DAILY_SYNC_TZ=Australia/Sydney
DAILY_SYNC_HOUR=0
DAILY_SYNC_MINUTE=0
DAILY_SYNC_GAP_SECONDS=45
