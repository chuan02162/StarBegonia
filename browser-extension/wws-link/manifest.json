{
  "manifest_version": 3,
  "name": "StarBegonia Everyday Rewards Link",
  "version": "0.2.0",
  "description": "Reads the Everyday Rewards session token so StarBegonia can sync eReceipts.",
  "key": "",
  "permissions": [],
  "host_permissions": ["https://www.everyday.com.au/*"],
  "externally_connectable": {
    "matches": [
      "https://1cchome1.duckdns.org/*",
      "https://localhost/*",
      "http://localhost/*",
      "https://127.0.0.1/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.everyday.com.au/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "StarBegonia Everyday Rewards"
  }
}
